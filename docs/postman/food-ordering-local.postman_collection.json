{
  "info": {
    "name": "Food Ordering Local",
    "_postman_id": "b6729a24-2646-4466-88fe-c9fca3f246d6",
    "description": "Coleccion base para pruebas locales via API Gateway + Keycloak.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "keycloakUrl", "value": "http://localhost:8080" },
    { "key": "realm", "value": "food-ordering" },
    { "key": "clientId", "value": "food-ordering-web" },
    { "key": "password", "value": "123456" },
    { "key": "adminToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "restaurantToken", "value": "" },
    { "key": "restaurantId", "value": "1" },
    { "key": "productId", "value": "1" },
    { "key": "orderId", "value": "1" }
  ],
  "item": [
    {
      "name": "00 Auth",
      "item": [
        {
          "name": "Token admin1",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "username", "value": "admin1", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token cliente1",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "username", "value": "cliente1", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('customerToken', json.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token restaurante1",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "username", "value": "restaurante1", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('restaurantToken', json.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Catalog",
      "item": [
        {
          "name": "Crear restaurante (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pizza Planet QA\",\n  \"description\": \"Restaurante para pruebas\",\n  \"address\": \"Av. Demo 123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/catalog/restaurants"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) pm.collectionVariables.set('restaurantId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear producto (restaurant)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{restaurantToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": {{restaurantId}},\n  \"name\": \"Pizza Margarita\",\n  \"description\": \"Clasica\",\n  \"price\": 25.5\n}"
            },
            "url": "{{baseUrl}}/api/v1/catalog/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) pm.collectionVariables.set('productId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar restaurantes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/catalog/restaurants"
          }
        },
        {
          "name": "Listar productos por restaurante",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/catalog/products/restaurant/{{restaurantId}}"
          }
        }
      ]
    },
    {
      "name": "02 User",
      "item": [
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "Agregar direccion",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Casa\",\n  \"line1\": \"Calle 1 234\",\n  \"line2\": \"Dep 401\",\n  \"district\": \"Miraflores\",\n  \"city\": \"Lima\",\n  \"reference\": \"Frente al parque\",\n  \"primaryAddress\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/users/me/addresses"
          }
        },
        {
          "name": "Listar direcciones",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/users/me/addresses"
          }
        }
      ]
    },
    {
      "name": "03 Orders and Flow",
      "item": [
        {
          "name": "Crear pedido (customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": {{restaurantId}},\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) pm.collectionVariables.set('orderId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Solicitar pago",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/request-payment"
          }
        },
        {
          "name": "Ver pedido por id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          }
        },
        {
          "name": "Ver pago por orderId",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/payments/order/{{orderId}}"
          }
        },
        {
          "name": "Ver delivery por orderId",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/deliveries/order/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "99 Observabilidad",
      "item": [
        {
          "name": "Gateway Prometheus",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/prometheus"
          }
        },
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health"
          }
        }
      ]
    }
  ]
}
